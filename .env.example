# ---------- API ----------
# When running outside docker, use localhost. The docker-compose file
# overrides DATABASE_URL/REDIS_URL to use service names.
API_HOST=0.0.0.0
API_PORT=8000

# SQLAlchemy sync URL — required.
# Local Postgres (from docker-compose): postgresql+psycopg://airwatch:airwatch_pw@localhost:5433/airwatch
# Inside the docker network:            postgresql+psycopg://airwatch:airwatch_pw@postgres:5432/airwatch
DATABASE_URL=postgresql+psycopg://airwatch:airwatch_pw@localhost:5433/airwatch

# ---------- Redis (Celery broker + result backend) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- CORS ----------
# Comma-separated list. Vite default is 5173.
CORS_ORIGINS=http://localhost:5173

# ---------- Data sources ----------
OPENAQ_API_BASE=https://api.openaq.org/v3
# Optional — without a key, OpenAQ rate-limits aggressively. Get one at https://openaq.org
OPENAQ_API_KEY=

OPENMETEO_BASE=https://api.open-meteo.com/v1

# ---------- SMTP (optional — only needed for /admin/alerts/send) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=AirWatch <no-reply@airwatch.example>
